{
  "name": "supplemental-tax-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Internal tool for analyzing CA supplemental tax bills",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:consumer": "cd consumer-app && npm run dev",
    "build": "cd frontend && npm run build",
    "build:consumer": "cd consumer-app && npm run build",
    "test:consumer": "cd consumer-app && npm test",
    "start": "cd backend && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../consumer-app && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
